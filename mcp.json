{
  "mcpServers": {
    "chrome-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@latest",
        "--slim",
        "--autoConnect",
        "--no-usage-statistics"
      ],
      "directTools": true
    },
    "searchcode": {
      "type": "http",
      "url": "https://api.searchcode.com/v1/mcp",
      "directTools": true
    },
    "tavily-remote-mcp": {
      "type": "http",
      "url": "https://mcp.tavily.com/mcp/",
      "directTools": true
    }
  }
}
