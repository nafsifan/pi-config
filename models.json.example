{
  "providers": {
    "my-provider": {
      "name": "渠道名称",
      "baseUrl": "https://api.openai.com/v1", // 接口地址（中转站或官方）
      "api": "openai-completions",           // 协议类型（openai-completions 或 anthropic-messages）
      "apiKey": "sk-xxx",                    // 你的 API Key
      "models": [
        {
          "id": "gpt-4o",                     // 真实模型 ID
          "name": "GPT-4o",                   // 界面显示名称
          "reasoning": false,                 // 是否开启思考/推理
          "input": ["text", "image"],         // 支持的输入格式
          "contextWindow": 128000,            // 最大上下文
          "maxTokens": 4096                   // 单次最大输出
        }
      ]
    }
  }
}
