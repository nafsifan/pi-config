{
  "lastChangelogVersion": "0.86.1",
  "theme": "dark",
  "defaultProvider": "localhost-gemini",
  "defaultModel": "gemini-3.8-flash-high",
  "defaultTools": [
    "read",
    "bash",
    "edit",
    "write"
  ],
  "packages": [
    "npm:pi-mcp-adapter",
    "npm:pi-web-access",
    "npm:pi-subagents",
    "npm:@dietrichgebert/ponytail",
    "npm:@narumitw/pi-statusline",
    "npm:@narumitw/pi-plan-mode",
    "npm:@ff-labs/pi-fff",
    "npm:pi-cc-extensions",
    "npm:pi-rtk-optimizer"
  ],
  "retry": {
    "enabled": true,
    "maxRetries": 8,
    "baseDelayMs": 10000,
    "provider": {
      "maxRetryDelayMs": 120000
    }
  },
  "quietStartup": true,
  "tuiMode": "regular",
  "fullscreenExitOutput": "transcript",
  "markdown": {
    "mermaid": "final"
  }
}
